# Copy these fields into the existing backend's private .env.dev / .env.prod.
# Default off: an unconfigured companion must not prevent the blog from starting.
CAT_COMPANION_ENABLED=false
CAT_AGENT_PROVIDER=deepseek
# CAT_AGENT_API_KEY=REPLACE_WITH_A_NEW_SERVER_ONLY_MODEL_KEY
# CAT_AGENT_MODEL=REPLACE_WITH_YOUR_MODEL_ID
CAT_AGENT_BASE_URL=https://api.deepseek.com
CAT_AGENT_TIMEOUT_MS=45000

# Development only: frontend and backend origins must be explicit localhost URLs.
# CAT_AGENT_ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100,http://127.0.0.1:3000

# Production: NODE_ENV=prod already selects production protections.
# Exact HTTPS origins, not paths or wildcard patterns; values here are examples.
# Uncomment and fill all four fields only for production (not local development).
# CAT_AGENT_ALLOWED_ORIGINS=https://your-blog.example
# CAT_AGENT_COOKIE_SECRET=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_BYTES
# CAT_AGENT_PROXY_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_BYTES
# CAT_AGENT_STATE_DIR=/var/lib/myblog/companion

# Single backend instance only. Use a persistent writable PRIVATE directory.
# Do not set CAT_AGENT_HOST, PORT or API_PREFIX: Nest owns the listener and routes.
CAT_AGENT_MAX_SESSIONS=256
CAT_AGENT_MAX_SESSIONS_PER_VISITOR=3
CAT_AGENT_MAX_SESSIONS_PER_NETWORK=24
CAT_AGENT_SESSION_TTL_MS=1800000
CAT_AGENT_SESSION_PER_MINUTE_VISITOR=6
CAT_AGENT_SESSION_PER_MINUTE_NETWORK=30
CAT_AGENT_MODEL_PER_MINUTE_VISITOR=12
CAT_AGENT_MODEL_PER_MINUTE_NETWORK=60
CAT_AGENT_MODEL_PER_DAY_VISITOR=200
CAT_AGENT_MODEL_PER_DAY_NETWORK=1000
CAT_AGENT_MODEL_PER_DAY_GLOBAL=2000
CAT_AGENT_MODEL_CONCURRENCY_VISITOR=2
CAT_AGENT_MODEL_CONCURRENCY_NETWORK=4
CAT_AGENT_MODEL_CONCURRENCY_GLOBAL=8
