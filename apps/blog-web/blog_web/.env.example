# Giscus 评论系统配置
# 前往 https://giscus.app 填写你的 GitHub 仓库信息，页面会自动生成以下三个值
NEXT_PUBLIC_GISCUS_REPO=owner/repo
NEXT_PUBLIC_GISCUS_REPO_ID=R_xxxxxxxxxx
NEXT_PUBLIC_GISCUS_CATEGORY_ID=DIC_xxxxxxxxxx

# Google Analytics
NEXT_PUBLIC_GA_ID=G-Q018EMFR1V

# Optional local companion API bridge; only active when NODE_ENV=development.
# Start Next bound to 127.0.0.1 (the existing dev:study script does this).
# The cat UI loads independently; this setting only connects local chat.
# Never use a public URL or a secret here.
# COMPANION_PREVIEW_API=http://127.0.0.1:3000
