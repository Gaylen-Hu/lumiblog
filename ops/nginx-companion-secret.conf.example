# Private deployment template. This repository contains no production token.
# Place a completed copy at /etc/nginx/snippets/myblog-companion-secret.conf,
# readable only by the Nginx administrator. Do not install this .example file.
# Generate an independent random token of at least 32 bytes; use the same value
# as the Nest backend CAT_AGENT_PROXY_TOKEN. Never put this in frontend variables.
# Uncomment only after replacing the placeholder with the real private value:
# set $companion_proxy_token "REPLACE_WITH_PRIVATE_RANDOM_PROXY_TOKEN";
